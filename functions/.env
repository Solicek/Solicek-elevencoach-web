# Nastavení Cloud Functions za běhu. Žádná tajemství sem nepatří – soubor je v repozitáři
# a nasazuje se s funkcemi (klíč ke Gemini žije v Secret Manageru).
#
# Limity generování AI. Změna = úprava čísla a `firebase deploy --only functions`.
AI_TEAM_DAILY_LIMIT=20
AI_TEAM_MINUTE_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=300
